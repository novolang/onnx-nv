// onnxtype.nv — element types, shapes whose dimensions may be names,
// tensors and value infos.
//
// A DIMENSION IS A NUMBER OR A NAME, NEVER A ZERO
//
// ONNX lets a dimension be either a fixed value or a `dim_param`: a
// STRING naming a dimension whose size is decided when the model runs.
// `batch` is the famous one, and a model exported for serving has it
// on every input.
//
// A library that flattened that to an integer — zero, or minus one —
// has thrown away the thing the consumer needed: a serving stack
// deciding whether two models can share a batch needs to know that
// both call it `batch`, and a shape checker needs to know that
// `sequence` in one place and `sequence` in another are the SAME
// unknown.  So `OnnxDim` has two arms and one of them carries the
// name, and a third for the case the file leaves genuinely blank.
//
// A TENSOR'S BYTES ARE KEPT RAW
//
// `TensorProto` can carry its data in a typed repeated field
// (`float_data`, `int32_data`) or in `raw_data`, a byte string in the
// tensor's own element order and the machine's little-endian layout.
// Every real exporter writes `raw_data`, because the typed fields cost
// a varint per element.
//
// This package hands back the bytes and the element type, and does not
// decode them into a list of floats.  A four-gigabyte weight tensor
// decoded into a `[Float]` is four gigabytes of boxed numbers, and the
// caller that wanted it wanted it in a buffer it chose.
// `onnxtype.element_count` and `onnxtype.element_bytes` are what it
// needs to do that.

use onnxfault

// The element type of a tensor: `TensorProto.DataType`.
//
// ```novo
// use onnxtype
//
// fn main() [io]
//     println("${onnxtype.type_code(OnnxFloat)}")   // 1
// ```
pub enum OnnxDataType
    // 0: the file did not say.  Legal in the schema and meaningless
    // in a tensor, so it is carried rather than guessed at.
    OnnxUndefined
    // 1: 32-bit IEEE float.
    OnnxFloat
    // 2: unsigned 8-bit.
    OnnxUint8
    // 3: signed 8-bit.
    OnnxInt8
    // 4: unsigned 16-bit.
    OnnxUint16
    // 5: signed 16-bit.
    OnnxInt16
    // 6: signed 32-bit.
    OnnxInt32
    // 7: signed 64-bit.  What every shape and index in ONNX is.
    OnnxInt64
    // 8: a UTF-8 string.  Stored in `string_data`, never in
    // `raw_data`, which is the one exception to the raw-bytes rule.
    OnnxString
    // 9: a boolean, one byte each.
    OnnxBool
    // 10: 16-bit IEEE float.
    OnnxFloat16
    // 11: 64-bit IEEE float.
    OnnxDouble
    // 12: unsigned 32-bit.
    OnnxUint32
    // 13: unsigned 64-bit.
    OnnxUint64
    // 14: a complex number of two 32-bit floats.
    OnnxComplex64
    // 15: a complex number of two 64-bit floats.
    OnnxComplex128
    // 16: bfloat16 — the same exponent range as `OnnxFloat` with
    // seven fewer mantissa bits, which is why a model trained in it
    // converts to float32 without overflowing and a float16 one does
    // not.
    OnnxBfloat16

// One dimension of a shape.
//
// ```novo
// use onnxtype
//
// fn main() [io]
//     println(onnxtype.dim_text(OnnxDimParam("batch")))   // batch
// ```
pub enum OnnxDim
    // A fixed size.
    OnnxDimValue(size: Int)
    // A symbolic size, named.  Two dimensions with the same name are
    // the same unknown, which is the fact a shape checker is built on
    // and the fact an integer cannot carry.
    OnnxDimParam(name: Str)
    // The file gave neither.  A dimension of unknown rank, which
    // `Reshape` with a computed shape produces.
    OnnxDimUnknown

// A tensor's shape: its rank and its dimensions.
//
// ```novo
// use std.list
// use onnxtype
//
// fn main() [io]
//     let s = onnxtype.shape([OnnxDimParam("batch"), OnnxDimValue(3)])
//     println("${onnxtype.rank(s)}")            // 2
// ```
pub struct OnnxShape
    // The dimensions, outermost first.
    dims: [OnnxDim]

// A tensor: an initializer's weights, or a constant attribute's value.
pub struct OnnxTensor
    // The name, which an initializer has and a constant attribute's
    // value usually does not.
    name: Str
    // The element type.
    data_type: OnnxDataType
    // The shape, as fixed sizes.  An initializer's dimensions are
    // always numbers: a weight with a symbolic dimension would be a
    // weight of unknown size.
    dims: [Int]
    // The elements, in the layout `raw_data` uses: the tensor's own
    // order, little-endian, no padding.  Empty for a string tensor,
    // whose elements are in `strings`.
    raw: Bytes
    // A string tensor's elements.  Empty for every other type.
    strings: [Str]
    // Where the data lives when it is not in this message at all, or
    // `""`.  Set for any tensor above the two-gigabyte protobuf
    // ceiling, which is every large model's weights.
    external_location: Str

// What a graph input, output or intermediate value is declared to be.
pub struct OnnxValueInfo
    // The name, which is what a node's input and output lists refer
    // to.
    name: Str
    // The element type.
    elem_type: OnnxDataType
    // The shape, whose dimensions may be names.
    shape: OnnxShape
    // The `doc_string`, or `""`.
    doc: Str

// The type's numeric code, 0 to 16.
//
// ```novo
// use onnxtype
//
// fn main() [io]
//     println("${onnxtype.type_code(OnnxInt64)}")   // 7
// ```
// `onnx.proto`'s `TensorProto.DataType` keeps growing past the end of
// this table.  The first seventeen codes — `0` through `16`, through
// `BFLOAT16` — are the ones modelled here, and every later code is
// refused as unknown rather than guessed at.  Reading one is a table
// and not a lookup, because the codes are the file's and the names are
// the specification's.
pub fn type_code(t: OnnxDataType) -> Int []
    match t
        OnnxUndefined  => 0
        OnnxFloat      => 1
        OnnxUint8      => 2
        OnnxInt8       => 3
        OnnxUint16     => 4
        OnnxInt16      => 5
        OnnxInt32      => 6
        OnnxInt64      => 7
        OnnxString     => 8
        OnnxBool       => 9
        OnnxFloat16    => 10
        OnnxDouble     => 11
        OnnxUint32     => 12
        OnnxUint64     => 13
        OnnxComplex64  => 14
        OnnxComplex128 => 15
        OnnxBfloat16   => 16

// The type a code names, or `OnnxUnknownDataType`.
//
// ```novo
// use onnxtype
//
// fn main() [io]
//     match onnxtype.type_of_code(99)
//         Ok(_)  => println("this cannot happen — 99 is past the table")
//         Err(e) => println(e.message())
// ```
pub fn type_of_code(code: Int) -> Result<OnnxDataType, OnnxFault> []
    if code < 0 or code > 16
        return Err(OnnxUnknownDataType(code))
    match code
        0  => Ok(OnnxUndefined)
        1  => Ok(OnnxFloat)
        2  => Ok(OnnxUint8)
        3  => Ok(OnnxInt8)
        4  => Ok(OnnxUint16)
        5  => Ok(OnnxInt16)
        6  => Ok(OnnxInt32)
        7  => Ok(OnnxInt64)
        8  => Ok(OnnxString)
        9  => Ok(OnnxBool)
        10 => Ok(OnnxFloat16)
        11 => Ok(OnnxDouble)
        12 => Ok(OnnxUint32)
        13 => Ok(OnnxUint64)
        14 => Ok(OnnxComplex64)
        15 => Ok(OnnxComplex128)
        _  => Ok(OnnxBfloat16)

// The type's name as `onnx.proto` spells it: `"FLOAT"`, `"INT64"`,
// `"BFLOAT16"`.
//
// ```novo
// use onnxtype
//
// fn main() [io]
//     println(onnxtype.type_name(OnnxBfloat16))   // BFLOAT16
// ```
pub fn type_name(t: OnnxDataType) -> Str []
    match t
        OnnxUndefined  => "UNDEFINED"
        OnnxFloat      => "FLOAT"
        OnnxUint8      => "UINT8"
        OnnxInt8       => "INT8"
        OnnxUint16     => "UINT16"
        OnnxInt16      => "INT16"
        OnnxInt32      => "INT32"
        OnnxInt64      => "INT64"
        OnnxString     => "STRING"
        OnnxBool       => "BOOL"
        OnnxFloat16    => "FLOAT16"
        OnnxDouble     => "DOUBLE"
        OnnxUint32     => "UINT32"
        OnnxUint64     => "UINT64"
        OnnxComplex64  => "COMPLEX64"
        OnnxComplex128 => "COMPLEX128"
        OnnxBfloat16   => "BFLOAT16"

// How many bytes one element takes, or `0` for `OnnxString` and
// `OnnxUndefined`, neither of which has a fixed width.
//
// ```novo
// use onnxtype
//
// fn main() [io]
//     println("${onnxtype.element_bytes(OnnxFloat16)}")   // 2
//     println("${onnxtype.element_bytes(OnnxString)}")    // 0
// ```
pub fn element_bytes(t: OnnxDataType) -> Int []
    match t
        OnnxUndefined  => 0
        OnnxFloat      => 4
        OnnxUint8      => 1
        OnnxInt8       => 1
        OnnxUint16     => 2
        OnnxInt16      => 2
        OnnxInt32      => 4
        OnnxInt64      => 8
        OnnxString     => 0
        OnnxBool       => 1
        OnnxFloat16    => 2
        OnnxDouble     => 8
        OnnxUint32     => 4
        OnnxUint64     => 8
        OnnxComplex64  => 8
        OnnxComplex128 => 16
        OnnxBfloat16   => 2

// Whether the type is floating point: the two complex types included,
// because their components are.
//
// ```novo
// use onnxtype
//
// fn main() [io]
//     println("${onnxtype.is_float(OnnxBfloat16)}")   // true
//     println("${onnxtype.is_float(OnnxInt64)}")      // false
// ```
pub fn is_float(t: OnnxDataType) -> Bool []
    match t
        OnnxFloat      => true
        OnnxFloat16    => true
        OnnxDouble     => true
        OnnxBfloat16   => true
        OnnxComplex64  => true
        OnnxComplex128 => true
        _              => false

// A shape from its dimensions.
//
// ```novo
// use onnxtype
//
// fn main() [io]
//     println("${onnxtype.rank(onnxtype.shape([OnnxDimValue(1)]))}")   // 1
// ```
pub fn shape(dims: [OnnxDim]) -> OnnxShape []
    OnnxShape { dims: dims }

// The product of a list of dimensions, which is `1` for the empty list
// because a rank-zero tensor holds one element.  Zero appears in a
// shape's own terms — an empty batch is `0 x 3` — and multiplies out
// the way it should.
fn product_of(dims: [Int]) -> Int
    var n = 1
    for d in dims
        n = n * d
    n

// A shape whose every dimension is a fixed number.
//
// ```novo
// use onnxtype
//
// fn main() [io]
//     println("${onnxtype.is_fully_known(onnxtype.fixed_shape([1, 3, 224, 224]))}")
// ```
pub fn fixed_shape(dims: [Int]) -> OnnxShape []
    var out: [OnnxDim] = []
    for d in dims
        list.push(out, OnnxDimValue(d))
    OnnxShape { dims: out }

// How many dimensions the shape has.
//
// ```novo
// use onnxtype
//
// fn main() [io]
//     println("${onnxtype.rank(onnxtype.fixed_shape([1, 3, 224, 224]))}")   // 4
// ```
pub fn rank(s: OnnxShape) -> Int []
    list.len(s.dims)

// A dimension as text: its number, its name, or `"?"`.
//
// What a shape is printed with, and the reason the three cases are
// distinguishable at all.
//
// ```novo
// use onnxtype
//
// fn main() [io]
//     println(onnxtype.dim_text(OnnxDimValue(224)))   // 224
//     println(onnxtype.dim_text(OnnxDimUnknown))      // ?
// ```
pub fn dim_text(d: OnnxDim) -> Str []
    match d
        OnnxDimValue(size) => "${size}"
        OnnxDimParam(name) => name
        OnnxDimUnknown     => "?"

// The shape as text: `"batch x 3 x 224 x 224"`.
//
// ```novo
// use onnxtype
//
// fn main() [io]
//     println(onnxtype.shape_text(onnxtype.shape([OnnxDimParam("batch"),
//                                                 OnnxDimValue(3)])))
// ```
pub fn shape_text(s: OnnxShape) -> Str []
    var parts: [Str] = []
    for d in s.dims
        list.push(parts, dim_text(d))
    str.join(parts, " x ")

// Whether every dimension is a fixed number.
//
// The question a caller allocating a buffer asks before it tries.
//
// ```novo
// use onnxtype
//
// fn main() [io]
//     println("${onnxtype.is_fully_known(onnxtype.shape([OnnxDimParam("batch")]))}")
// ```
pub fn is_fully_known(s: OnnxShape) -> Bool []
    for d in s.dims
        match d
            OnnxDimValue(_) => ()
            _               =>
                return false
    true

// How many elements the shape holds, or `None` when any dimension is
// symbolic or unknown.
//
// `None` and not zero.  A zero-element tensor is a real thing — an
// empty batch — and answering zero for "I do not know" would make a
// caller allocate nothing for a model that needed everything.
//
// ```novo
// use onnxtype
//
// fn main() [io]
//     match onnxtype.element_count(onnxtype.fixed_shape([2, 3]))
//         Some(n) => println("${n}")            // 6
//         None    => println("not fully known")
// ```
pub fn element_count(s: OnnxShape) -> ?Int []
    var n = 1
    for d in s.dims
        match d
            OnnxDimValue(size) =>
                n = n * size
            _                  =>
                return None
    Some(n)

// Every symbolic dimension name in the shape, in order, without
// repeats.
//
// What a serving stack collects to find out which models can share a
// batch, and what a shape checker unifies over.
//
// ```novo
// use std.list
// use onnxtype
//
// fn main() [io]
//     let s = onnxtype.shape([OnnxDimParam("batch"), OnnxDimValue(3),
//                             OnnxDimParam("batch")])
//     println("${list.len(onnxtype.symbols_of(s))}")   // 1
// ```
pub fn symbols_of(s: OnnxShape) -> [Str] []
    var out: [Str] = []
    for d in s.dims
        match d
            OnnxDimParam(name) =>
                if not list.contains(out, name)
                    list.push(out, name)
            _                  => ()
    out

// The shape with every occurrence of a named dimension replaced by a
// number.
//
// What a serving stack does when the batch size is finally known.
//
// ```novo
// use onnxtype
//
// fn main() [io]
//     let s = onnxtype.shape([OnnxDimParam("batch"), OnnxDimValue(3)])
//     println("${onnxtype.is_fully_known(onnxtype.bind_symbol(s, "batch", 8))}")
// ```
pub fn bind_symbol(s: OnnxShape, name: Str, size: Int) -> OnnxShape []
    var out: [OnnxDim] = []
    for d in s.dims
        match d
            OnnxDimParam(symbol) =>
                if symbol == name
                    list.push(out, OnnxDimValue(size))
                else
                    list.push(out, d)
            _                    => list.push(out, d)
    OnnxShape { dims: out }

// A tensor from its parts.
//
// ```novo
// use std.bytes
// use onnxtype
//
// fn main() [io]
//     let t = onnxtype.tensor("W", OnnxFloat, [2, 3], bytes.zeros(24))
//     println("${t.name}")                      // W
// ```
pub fn tensor(name: Str, data_type: OnnxDataType, dims: [Int], raw: Bytes) -> OnnxTensor []
    OnnxTensor { name: name, data_type: data_type, dims: dims, raw: raw,
                 strings: [], external_location: "" }

// How many elements the tensor holds, from its dimensions.
//
// ```novo
// use std.bytes
// use onnxtype
//
// fn main() [io]
//     let t = onnxtype.tensor("W", OnnxFloat, [2, 3], bytes.zeros(24))
//     println("${onnxtype.tensor_element_count(t)}")   // 6
// ```
pub fn tensor_element_count(t: OnnxTensor) -> Int []
    product_of(t.dims)

// How many bytes the tensor's data should occupy: elements times
// element width.
//
// Compared against `bytes.len(t.raw)` by `onnxcheck`, and the
// comparison that catches a model truncated in transit.
//
// ```novo
// use std.bytes
// use onnxtype
//
// fn main() [io]
//     let t = onnxtype.tensor("W", OnnxFloat, [2, 3], bytes.zeros(24))
//     println("${onnxtype.tensor_byte_length(t)}")   // 24
// ```
pub fn tensor_byte_length(t: OnnxTensor) -> Int []
    tensor_element_count(t) * element_bytes(t.data_type)

// Whether the tensor's data lives in a separate file.
//
// True for any weight above the two-gigabyte protobuf ceiling, which
// is every large model.  `onnxio.attach_external` is what a caller
// that has read the file calls.
//
// ```novo
// use std.bytes
// use onnxtype
//
// fn main() [io]
//     let t = onnxtype.tensor("W", OnnxFloat, [2, 3], bytes.zeros(24))
//     println("${onnxtype.is_external(t)}")     // false
// ```
pub fn is_external(t: OnnxTensor) -> Bool []
    str.len(t.external_location) > 0

// A value info from its parts.
//
// ```novo
// use onnxtype
//
// fn main() [io]
//     let v = onnxtype.value_info("x", OnnxFloat,
//                                 onnxtype.shape([OnnxDimParam("batch")]))
//     println(v.name)                           // x
// ```
pub fn value_info(name: Str, elem_type: OnnxDataType, shape: OnnxShape) -> OnnxValueInfo []
    OnnxValueInfo { name: name, elem_type: elem_type, shape: shape, doc: "" }

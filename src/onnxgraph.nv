// onnxgraph.nv — the model, the graph, the nodes, and the subgraph
// table that keeps the value types finite.
//
// SUBGRAPHS ARE HELD IN A FLAT TABLE, NOT NESTED
//
// A graph holds nodes, a node holds attributes, and an attribute can
// hold a graph — `If` has two, `Loop` and `Scan` have one each.  That
// is a directly recursive value type, which cannot be written.
//
// So `OnnxModel` holds ONE flat table of graphs, an attribute refers
// to one by index, and `subgraph_at` resolves it.  The shape is
// markdown-nv's arena: the tree is one allocation rather than one per
// node, an index is stable and comparable, and a traversal is an index
// walk.
//
// It also means a walk over every node in a model is a fold over the
// table, which is what `all_nodes` is — and a caller that forgot to
// descend into control flow would otherwise report a model with an
// `If` as having four nodes.
//
// A NODE REFERS TO VALUES BY NAME, AND THE NAMES ARE THE EDGES
//
// There is no edge list in ONNX.  A node's `output` is a list of names
// and another node's `input` is a list of names, and they are the same
// names.  So the graph structure is a string join, and
// `producer_of`, `consumers_of` and `topological_order` are the three
// functions that do it once rather than in every consumer.
//
// The empty string is meaningful in that list: it means an OPTIONAL
// INPUT THAT IS NOT SUPPLIED.  `Clip`'s `min` can be empty and its
// `max` present, and a reader that filtered out the empty names would
// shift `max` into `min`'s place and change what the model computes.

use onnxattr
use onnxopset
use pbunknown
use onnxfault
use onnxtype

// One operator-set import: a domain and the version of it this model
// uses.
//
// ```novo
// use onnxgraph
//
// fn main() [io]
//     println("${onnxgraph.opset_import("", 17).version}")   // 17
// ```
pub struct OnnxOpsetImport
    // The domain.  `""` is the default ONNX operator set;
    // `"ai.onnx.ml"` is the traditional machine-learning one;
    // `"com.microsoft"` and the rest are vendors'.
    domain: Str
    // Which version of that domain's operator set the model is
    // written against.
    version: Int

// One node: an operator, its inputs, its outputs and its attributes.
pub struct OnnxNode
    // The node's name.  ONNX allows it to be empty, and many
    // exporters leave it so, which is why every message in this
    // package carries the index as well.
    name: Str
    // The operator: `Conv`, `MatMul`, `If`.
    op_type: Str
    // The domain the operator is from.  `""` for the default set.
    domain: Str
    // The names of the values this node consumes, in the operator's
    // own order.  An EMPTY STRING means an optional input that is not
    // supplied, and its position matters.
    input: [Str]
    // The names of the values this node produces.
    output: [Str]
    // The attributes, in the order the file wrote them.
    attribute: [OnnxAttribute]
    // The `doc_string`, or `""`.
    doc: Str

// One graph: nodes, what goes in, what comes out, and the weights.
pub struct OnnxGraph
    // The graph's name.
    name: Str
    // The nodes.  ONNX requires them to be in topological order in
    // the file; `onnxcheck` reports a model where they are not, and
    // this list is what the file said.
    node: [OnnxNode]
    // What the graph takes.  Includes the initializers in models
    // exported before IR version 4, which is why
    // `true_inputs` exists.
    input: [OnnxValueInfo]
    // What the graph produces.
    output: [OnnxValueInfo]
    // Declared types for intermediate values.  Optional, often
    // absent, and what a shape checker fills in.
    value_info: [OnnxValueInfo]
    // The weights, as named tensors.
    initializer: [OnnxTensor]
    // The `doc_string`, or `""`.
    doc: Str

// One model: the file.
pub struct OnnxModel
    // The IR version — the version of the FORMAT, not of the operator
    // set.  Two different numbers that are confused constantly:
    // `ir_version` 8 with `opset_import` 17 is an ordinary 2022 model.
    ir_version: Int
    // Which operator sets, and which versions of them.
    opset_import: [OnnxOpsetImport]
    // What wrote the file: `"pytorch"`, `"tf2onnx"`.
    producer_name: Str
    // Which version of it.
    producer_version: Str
    // The model's domain, a reverse-DNS name, or `""`.
    domain: Str
    // The model's own version number.
    model_version: Int
    // The `doc_string`, or `""`.
    doc: Str
    // The main graph's index into `graphs`, which is always 0.
    main: Int
    // EVERY graph in the model, the main one first and every subgraph
    // after it.  Flat, because a graph that held its subgraphs
    // directly would be a recursive value type.
    graphs: [OnnxGraph]
    // Fields of the file this package does not model, kept so that a
    // write puts them back.
    unknown: PbUnknownSet

// An operator-set import.
//
// ```novo
// use onnxgraph
//
// fn main() [io]
//     println(onnxgraph.opset_import("ai.onnx.ml", 3).domain)
// ```
pub fn opset_import(domain: Str, version: Int) -> OnnxOpsetImport []
    OnnxOpsetImport { domain: domain, version: version }

// The version of a domain this model imports, or `None`.
//
// The number every operator lookup needs: an operator's behaviour is
// decided by the version of ITS OWN domain, and a model can import
// several.
//
// ```novo
// use onnxgraph
//
// fn main() [io]
//     match onnxgraph.opset_version(onnxgraph.empty_model(), "")
//         Some(v) => println("${v}")
//         None    => println("the default domain is not imported")
// ```
pub fn opset_version(m: OnnxModel, domain: Str) -> ?Int []
    for i in m.opset_import
        if i.domain == domain
            return Some(i.version)
    None

// A model with one empty graph and nothing else.
//
// What a builder starts from.
//
// ```novo
// use std.list
// use onnxgraph
//
// fn main() [io]
//     println("${list.len(onnxgraph.empty_model().graphs)}")   // 1
// ```
pub fn empty_model() -> OnnxModel []
    // The IR version this package reads, because a model it builds is
    // written for the reader that will read it back.
    let ir = onnxopset.ONNX_MAX_IR_VERSION
    OnnxModel { ir_version: ir, opset_import: [],
                producer_name: "", producer_version: "", domain: "",
                model_version: 0, doc: "", main: 0,
                graphs: [OnnxGraph { name: "", node: [], input: [], output: [],
                                     value_info: [], initializer: [], doc: "" }],
                unknown: pbunknown.empty() }

// The model's main graph.
//
// ```novo
// use std.list
// use onnxgraph
//
// fn main() [io]
//     println("${list.len(onnxgraph.main_graph(onnxgraph.empty_model()).node)}")   // 0
// ```
pub fn main_graph(m: OnnxModel) -> OnnxGraph []
    list.get(m.graphs, m.main)

// The graph an attribute's index refers to, or `None`.
//
// ```novo
// use onnxgraph
//
// fn main() [io]
//     match onnxgraph.subgraph_at(onnxgraph.empty_model(), 9)
//         Some(_) => println("this cannot happen — an empty model has one graph")
//         None    => println("no such subgraph")
// ```
pub fn subgraph_at(m: OnnxModel, index: Int) -> ?OnnxGraph []
    var i = 0
    for g in m.graphs
        if i == index
            return Some(g)
        i = i + 1
    None

// A node from its parts.
//
// ```novo
// use onnxgraph
//
// fn main() [io]
//     let n = onnxgraph.node("conv1", "Conv", ["x", "W"], ["y"])
//     println(n.op_type)                        // Conv
// ```
pub fn node(name: Str, op_type: Str, input: [Str], output: [Str]) -> OnnxNode []
    OnnxNode { name: name, op_type: op_type, domain: "", input: input,
               output: output, attribute: [], doc: "" }

// The same node with an attribute set, replacing any of the same name.
//
// ```novo
// use std.list
// use onnxattr
// use onnxgraph
//
// fn main() [io]
//     let n = onnxgraph.node("conv1", "Conv", ["x", "W"], ["y"])
//     let k = onnxgraph.with_attribute(n, onnxattr.ints_attr("kernel_shape", [3, 3]))
//     println("${list.len(k.attribute)}")       // 1
// ```
pub fn with_attribute(n: OnnxNode, a: OnnxAttribute) -> OnnxNode []
    // A replacement keeps the place the attribute it replaced had, so
    // the list stays the order the file wrote.
    var out: [OnnxAttribute] = []
    var replaced = false
    for old in n.attribute
        if old.name == a.name
            list.push(out, a)
            replaced = true
        else
            list.push(out, old)
    if not replaced
        list.push(out, a)
    OnnxNode { name: n.name, op_type: n.op_type, domain: n.domain,
               input: n.input, output: n.output, attribute: out, doc: n.doc }

// A node's attribute by name, or `None`.
//
// ```novo
// use onnxgraph
//
// fn main() [io]
//     let n = onnxgraph.node("conv1", "Conv", ["x", "W"], ["y"])
//     match onnxgraph.attribute_of(n, "kernel_shape")
//         Some(_) => println("present")
//         None    => println("absent")
// ```
pub fn attribute_of(n: OnnxNode, name: Str) -> ?OnnxAttribute []
    onnxattr.named(n.attribute, name)

// How many of a node's inputs are actually supplied.
//
// AN EMPTY NAME IS AN OMITTED OPTIONAL INPUT WHOSE POSITION MATTERS.
// `Clip`'s `min` can be empty with its `max` present, and a reader
// that filtered the empty names out would shift `max` into `min`'s
// place and change what the model computes.  So `input` keeps the
// empty strings and this counts the rest.
//
// ```novo
// use onnxgraph
//
// fn main() [io]
//     let n = onnxgraph.node("c", "Clip", ["x", "", "hi"], ["y"])
//     println("${onnxgraph.supplied_input_count(n)}")   // 2
// ```
pub fn supplied_input_count(n: OnnxNode) -> Int []
    var count = 0
    for x in n.input
        if str.len(x) > 0
            count = count + 1
    count

// Whether the input at a position is supplied.
//
// ```novo
// use onnxgraph
//
// fn main() [io]
//     let n = onnxgraph.node("c", "Clip", ["x", "", "hi"], ["y"])
//     println("${onnxgraph.has_input_at(n, 1)}")   // false
// ```
pub fn has_input_at(n: OnnxNode, index: Int) -> Bool []
    var i = 0
    for x in n.input
        if i == index
            return str.len(x) > 0
        i = i + 1
    false

// Every node of every graph in the model, with the index of the graph
// it came from.
//
// THE WALK THAT DOES NOT MISS CONTROL FLOW.  A caller that iterated
// the main graph's `node` list would report a model with an `If` as
// having four nodes and would never see the branches.
//
// ```novo
// use std.list
// use onnxgraph
//
// fn main() [io]
//     println("${list.len(onnxgraph.all_nodes(onnxgraph.empty_model()))}")   // 0
// ```
pub fn all_nodes(m: OnnxModel) -> [(Int, OnnxNode)] []
    var out: [(Int, OnnxNode)] = []
    var gi = 0
    for g in m.graphs
        for n in g.node
            list.push(out, (gi, n))
        gi = gi + 1
    out

// The subgraph indices a node's attributes refer to.
//
// ```novo
// use std.list
// use onnxgraph
//
// fn main() [io]
//     let n = onnxgraph.node("f", "If", ["cond"], ["y"])
//     println("${list.len(onnxgraph.walk_subgraphs(n))}")   // 0
// ```
pub fn walk_subgraphs(n: OnnxNode) -> [Int] []
    var out: [Int] = []
    for a in n.attribute
        for index in onnxattr.subgraph_indices(a)
            list.push(out, index)
    out

// The graph's inputs that are NOT also initializers.
//
// Before IR version 4, an initializer had to appear in `input` as
// well, so a model exported by an older tool lists its weights among
// the things a caller must supply.  A serving stack that trusted
// `input` would ask for a hundred tensors it already has.
//
// ```novo
// use std.list
// use onnxgraph
//
// fn main() [io]
//     println("${list.len(onnxgraph.true_inputs(onnxgraph.main_graph(onnxgraph.empty_model())))}")
// ```
pub fn true_inputs(g: OnnxGraph) -> [OnnxValueInfo] []
    var out: [OnnxValueInfo] = []
    for v in g.input
        var is_weight = false
        for t in g.initializer
            if t.name == v.name
                is_weight = true
        if not is_weight
            list.push(out, v)
    out

// The node that produces a named value, or `None`.
//
// `None` for a graph input and for an initializer, both of which are
// produced by nothing.
//
// ```novo
// use onnxgraph
//
// fn main() [io]
//     match onnxgraph.producer_of(onnxgraph.main_graph(onnxgraph.empty_model()), "y")
//         Some(_) => println("produced")
//         None    => println("a graph input, an initializer, or absent")
// ```
pub fn producer_of(g: OnnxGraph, name: Str) -> ?OnnxNode []
    // An empty name is the "optional input not supplied" marker in an
    // input list and never a value's name, so nothing produces it.
    if str.len(name) == 0
        return None
    for n in g.node
        for out in n.output
            if out == name
                return Some(n)
    None

// The node indices that consume a named value.
//
// ```novo
// use std.list
// use onnxgraph
//
// fn main() [io]
//     let g = onnxgraph.main_graph(onnxgraph.empty_model())
//     println("${list.len(onnxgraph.consumers_of(g, "x"))}")   // 0
// ```
pub fn consumers_of(g: OnnxGraph, name: Str) -> [Int] []
    var out: [Int] = []
    // As in `producer_of`: the empty name is a position, not a value,
    // so no node is its consumer.
    if str.len(name) == 0
        return out
    var i = 0
    for n in g.node
        if list.contains(n.input, name)
            list.push(out, i)
        i = i + 1
    out

// An initializer by name, or `None`.
//
// ```novo
// use onnxgraph
//
// fn main() [io]
//     match onnxgraph.initializer_of(onnxgraph.main_graph(onnxgraph.empty_model()), "W")
//         Some(_) => println("present")
//         None    => println("absent")
// ```
pub fn initializer_of(g: OnnxGraph, name: Str) -> ?OnnxTensor []
    for t in g.initializer
        if t.name == name
            return Some(t)
    None

// The value info for a name, looking in the inputs, the outputs and
// `value_info`, or `None`.
//
// ```novo
// use onnxgraph
//
// fn main() [io]
//     match onnxgraph.type_of(onnxgraph.main_graph(onnxgraph.empty_model()), "x")
//         Some(_) => println("declared")
//         None    => println("undeclared, which is ordinary for an intermediate")
// ```
pub fn type_of(g: OnnxGraph, name: Str) -> ?OnnxValueInfo []
    for v in g.input
        if v.name == name
            return Some(v)
    for v in g.output
        if v.name == name
            return Some(v)
    for v in g.value_info
        if v.name == name
            return Some(v)
    None

// Whether every node's inputs are produced before it, which is what
// "the file stored the nodes in topological order" means.
//
// THE MAP IS BUILT OVER THE WHOLE NODE LIST BEFORE ANY NODE IS
// CHECKED, because an input whose producer comes LATER is exactly the
// defect being looked for: a walk that only remembered what it had
// already passed would call such a graph sorted, and every consumer of
// this answer — the checker's note, the ordering's fast path — would
// then be wrong in the direction that matters.
//
// The empty name is skipped: it is the omitted-optional marker, and
// nothing produces it.
fn nodes_in_order(g: OnnxGraph) -> Bool
    // First producer wins, the same rule `producer_of` uses.
    var producer: HashMap<Str, Int> = HashMap.new()
    var i = 0
    for n in g.node
        for out in n.output
            if not producer.has(out)
                producer.set(out, i)
        i = i + 1
    i = 0
    for n in g.node
        for name in n.input
            if str.len(name) > 0
                match producer.get(name)
                    Some(p) =>
                        if p >= i
                            return false
                    None    => ()
        i = i + 1
    true

// The name of the node at an index, or `""` past the end.
fn node_name_at(g: OnnxGraph, index: Int) -> Str
    var i = 0
    for n in g.node
        if i == index
            return n.name
        i = i + 1
    // cov: skip — `cycle_at` is an index below the node count, so the walk above returns before it and the fallback is unreachable
    ""

// The node indices in an order where every node comes after the nodes
// producing its inputs, or `OnnxGraphHasCycle`.
//
// ONNX requires the file to store the nodes in this order already, and
// a great many exporters have got it wrong.  So this both CHECKS and
// ANSWERS: a graph that was already in order comes back unchanged, and
// one that was not comes back usable.
//
// ```novo
// use std.list
// use onnxgraph
//
// fn main() [io]
//     match onnxgraph.topological_order(onnxgraph.main_graph(onnxgraph.empty_model()))
//         Ok(order) => println("${list.len(order)}")   // 0
//         Err(e)    => println(e.message())
// ```
pub fn topological_order(g: OnnxGraph) -> Result<[Int], OnnxFault> []
    let count = list.len(g.node)
    var order: [Int] = []
    var i = 0
    // The file's own order, unchanged, for the ordinary case.
    if nodes_in_order(g)
        while i < count
            list.push(order, i)
            i = i + 1
        return Ok(order)
    // First producer wins, the same rule `producer_of` uses.
    var producer: HashMap<Str, Int> = HashMap.new()
    var k = 0
    for n in g.node
        for out in n.output
            if not producer.has(out)
                producer.set(out, k)
        k = k + 1
    // Kahn's algorithm: a node becomes ready when its last producer
    // has been placed, and the file's order breaks the ties.
    var indegree = list.zeros(count)
    var successors: [[Int]] = []
    var s = 0
    while s < count
        list.push(successors, [])
        s = s + 1
    var a = 0
    for n in g.node
        for name in n.input
            if str.len(name) > 0
                match producer.get(name)
                    Some(p) =>
                        indegree[a] = indegree[a] + 1
                        list.push(successors[p], a)
                    None    => ()
        a = a + 1
    var ready: [Int] = []
    for q in 0..count
        if indegree[q] == 0
            list.push(ready, q)
    var head = 0
    while head < list.len(ready)
        let v = list.get(ready, head)
        head = head + 1
        list.push(order, v)
        for w in successors[v]
            indegree[w] = indegree[w] - 1
            if indegree[w] == 0
                list.push(ready, w)
    // Whatever still holds an in-degree is in a cycle, or behind one.
    // The first of them is the node the refusal names.
    var cycle_at: ?Int = None
    for r in 0..count
        if indegree[r] > 0 and cycle_at == None
            cycle_at = Some(r)
    match cycle_at
        Some(at) => Err(OnnxGraphHasCycle(at, node_name_at(g, at)))
        None     => Ok(order)

// Whether the graph's nodes are already in topological order.
//
// ```novo
// use onnxgraph
//
// fn main() [io]
//     println("${onnxgraph.is_sorted(onnxgraph.main_graph(onnxgraph.empty_model()))}")
// ```
pub fn is_sorted(g: OnnxGraph) -> Bool []
    nodes_in_order(g)

// How many bytes the model's initializers hold in total.
//
// The number that says whether a model will fit in memory, and the one
// a caller checks before it reads a file at all.
//
// ```novo
// use onnxgraph
//
// fn main() [io]
//     println("${onnxgraph.weight_bytes(onnxgraph.empty_model())}")   // 0
// ```
pub fn weight_bytes(m: OnnxModel) -> Int []
    var total = 0
    for g in m.graphs
        for t in g.initializer
            total = total + bytes.len(t.raw)
            // A string tensor's elements are the bytes, and they are
            // not in `raw`.
            for s in t.strings
                total = total + str.len(s)
    total

// Every distinct operator the model uses, as a domain and an op type.
//
// WHAT A RUNTIME ASKS BEFORE IT LOADS ANYTHING: whether it implements
// every operator in the file.  Answering it from the graph costs one
// walk; discovering it during execution costs a half-finished run.
//
// ```novo
// use std.list
// use onnxgraph
//
// fn main() [io]
//     println("${list.len(onnxgraph.operators_used(onnxgraph.empty_model()))}")   // 0
// ```
pub fn operators_used(m: OnnxModel) -> [(Str, Str)] []
    var out: [(Str, Str)] = []
    for g in m.graphs
        for n in g.node
            let op = (n.domain, n.op_type)
            if not list.contains(out, op)
                list.push(out, op)
    out

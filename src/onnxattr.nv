pub fn string_attr(name: Str, value: Str) -> OnnxAttribute []
    todo("onnx-nv.onnxattr.string_attr")

// A tensor attribute: what `Constant`'s `value` is.
//
// ```novo
// use std.bytes
// use onnxattr
// use onnxtype
//
// fn main() [io]
//     let t = onnxtype.tensor("", OnnxFloat, [1], bytes.zeros(4))
//     println(onnxattr.tensor_attr("value", t).name)   // value
// ```
pub fn tensor_attr(name: Str, value: OnnxTensor) -> OnnxAttribute []
    todo("onnx-nv.onnxattr.tensor_attr")

// An integer attribute's value, or `None` when it is not one.
//
// `None` rather than a default, because an attribute's default is the
// OPERATOR's, not this package's: `axis` defaults to 1 on `Softmax`
// before opset 13 and to -1 after it, and a library that answered 0
// would be silently wrong on both.
//
// ```novo
// use onnxattr
//
// fn main() [io]
//     match onnxattr.as_int(onnxattr.int_attr("axis", 1))
//         Some(n) => println("${n}")            // 1
//         None    => println("not an integer attribute")
// ```
pub fn as_int(a: OnnxAttribute) -> ?Int []
    todo("onnx-nv.onnxattr.as_int")

// A list-of-integers attribute's value, or `None`.
//
// ```novo
// use std.list
// use onnxattr
//
// fn main() [io]
//     match onnxattr.as_ints(onnxattr.ints_attr("pads", [0, 0, 1, 1]))
//         Some(xs) => println("${list.len(xs)}")   // 4
//         None     => println("not a list of integers")
// ```
pub fn as_ints(a: OnnxAttribute) -> ?[Int] []
    todo("onnx-nv.onnxattr.as_ints")


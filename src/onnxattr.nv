// ```novo
// use onnxattr
//
// fn main() [io]
//     let attrs = [onnxattr.int_attr("axis", 1)]
//     match onnxattr.named(attrs, "axis")
//         Some(a) => println(a.name)            // axis
//         None    => println("absent")
// ```

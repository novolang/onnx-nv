// onnxopset.nv — the operator-set table, carried as data.
//
// AN OPERATOR IS NOT ONE THING; IT IS A SEQUENCE OF VERSIONS
//
// `Squeeze` took its axes as an ATTRIBUTE up to opset 12 and as an
// INPUT from opset 13.  `Softmax`'s `axis` defaulted to 1 before opset
// 13 and to -1 after it.  `Resize` changed its input list three times.
// Every one of those is the same `op_type` string, and a checker that
// looked only at the string would pass a model that no runtime can
// load.
//
// So the table is keyed by domain, op type AND version: `schema_for`
// takes the version the model imported and answers the schema that was
// in force, which is the one with the largest `since_version` no
// greater than it.
//
// WHAT THE TABLE CARRIES AND WHAT IT DOES NOT
//
// It carries what can be checked from the graph alone: the arity, which
// inputs and outputs are optional, which are variadic, and at which
// version each spelling came in.  It does NOT carry type constraints,
// shape inference rules or reference implementations — those are the
// operator's semantics, they are the majority of the ONNX
// specification's bulk, and a package that shipped them would be
// shipping a runtime.
//
// The division is exactly the one the row draws: this package reads
// and checks a model, and `libonnxruntime-sys` runs it.

// What one operator looked like at one version.
//
// ```novo
// use onnxopset
//
// fn main() [io]
//     match onnxopset.schema_for("", "Conv", 17)
//         Some(s) => println("${s.min_input}")   // 2
//         None    => println("not in the table")
// ```
pub struct OnnxOpSchema
    // The domain: `""` for the default set.
    domain: Str
    // The operator: `Conv`, `MatMul`, `If`.
    op_type: Str
    // The version at which THIS spelling of the operator came in.  A
    // model importing a version below it is using an operator that did
    // not exist yet.
    since_version: Int
    // The fewest inputs a node may have.  Counts SUPPLIED inputs, so
    // an omitted optional input in the middle of the list does not
    // count.
    min_input: Int
    // The most it may have, or `-1` when the last input is variadic —
    // `Concat`, `Sum`, `Max`.
    max_input: Int
    // The fewest outputs.
    min_output: Int
    // The most, or `-1` when variadic — `Split`.
    max_output: Int
    // The names of the attributes the operator accepts, in the
    // specification's order.
    attributes: [Str]
    // Which of those the operator REQUIRES.  An operator whose
    // required attribute is missing cannot run, and it is the one
    // attribute fault worth reporting as a fault rather than a
    // difference.
    required_attributes: [Str]
    // Whether this version is deprecated.  `Upsample` after opset 10
    // is the example: still loadable, replaced by `Resize`, and worth
    // telling a caller about before it builds on one.
    deprecated: Bool

// The largest opset version of the default domain this table knows.
//
// A model importing a larger one is not refused — the graph still
// reads — but `onnxcheck` reports that the table cannot speak for it.
pub const ONNX_MAX_OPSET = 21

// The version of `ir_version` this package understands.
pub const ONNX_MAX_IR_VERSION = 10

// The table is scanned, not indexed.
//
// A row's key is a prefix of the row — `"|Conv|"`, `"ai.onnx.ml|SVMRegressor|"`
// — so a row that is not the operator being asked for differs within
// the first few bytes and costs one `starts_with`.  The alternative, a
// `HashMap<Str, [OnnxOpSchema]>` built on first use, trades that scan
// for materialising five hundred and nineteen structs, each with two
// string lists, to answer a question that usually needs one.  The scan
// is the cheaper of the two and the one with no state.
//
// The `|` in the key is what keeps `TreeEnsemble` from matching
// `TreeEnsembleClassifier`: the delimiter is part of the prefix.

// One row split into its ten fields.
//
// The split is only done for a row the prefix already matched, so a
// lookup pays for one split, not for five hundred.
fn fields_of(line: Str) -> [Str]
    str.split(line, "|")

// The integer in a field, or `0` for an empty one.
//
// The table leaves a field empty rather than writing the zero the
// schema did not mean: `max_input` empty would be "no input allowed",
// and the table writes `-1` for variadic.
fn int_field(fields: [Str], index: Int) -> Int
    match str.to_int(list.get(fields, index))
        Some(n) => n
        // cov: skip — every row of the generated table carries all ten fields, so `str.to_int` never meets a field that is not a number; the table's shape is pinned by tests/onnxopset_tests.nv
        None    => 0

// A comma-separated name field as a list, empty for an empty field.
fn names_field(fields: [Str], index: Int) -> [Str]
    let text = list.get(fields, index)
    if str.len(text) == 0
        return []
    str.split(text, ",")

// The `since_version` of a row, which is the field the table is
// ordered by.
fn since_of(line: Str) -> Int
    int_field(fields_of(line), 2)

// The domain of a row, which is the field before the first `|`.
fn domain_of(line: Str) -> Str
    match str.index(line, "|")
        Some(at) => str.slice(line, 0, at)
        // cov: skip — every row of the generated table holds a '|', so the domain lookup always finds one; the table's shape is pinned by tests/onnxopset_tests.nv
        None     => ""

// A row as a schema.
fn schema_of_line(line: Str) -> OnnxOpSchema
    let f = fields_of(line)
    OnnxOpSchema {
        domain: list.get(f, 0),
        op_type: list.get(f, 1),
        since_version: int_field(f, 2),
        min_input: int_field(f, 3),
        max_input: int_field(f, 4),
        min_output: int_field(f, 5),
        max_output: int_field(f, 6),
        deprecated: str.len(list.get(f, 7)) > 0,
        required_attributes: names_field(f, 8),
        attributes: names_field(f, 9) }

// A schema inserted into a list kept in `since_version` order.
//
// The table is emitted in that order already, so this walks the list
// without moving anything for every row the generator produced; it is
// here so that the answer does not depend on the generator having done
// so.
fn insert_by_since(xs: [OnnxOpSchema], s: OnnxOpSchema) -> [OnnxOpSchema]
    var out: [OnnxOpSchema] = []
    var placed = false
    for x in xs
        if not placed and s.since_version < x.since_version
            // cov: skip — the table is generated in ascending `since_version` order within each domain and op, so this walk never inserts; the branch is here so that the answer does not depend on the generator having sorted it
            list.push(out, s)
            // cov: skip — the other half of the insertion above: `placed` is only set where a row is out of order, which the generated table never is
            placed = true
        list.push(out, x)
    if not placed
        list.push(out, s)
    out

// The schema in force for an operator at a version, or `None`.
//
// The one with the largest `since_version` no greater than `version`.
// `None` when the table does not know the operator at all, or knows it
// only at versions above `version` — which is a model using an
// operator that did not exist yet, and is what `onnxcheck` reports.
//
// ```novo
// use onnxopset
//
// fn main() [io]
//     match onnxopset.schema_for("", "Squeeze", 11)
//         Some(s) => println("${s.min_input}")   // 1 — axes was an attribute then
//         None    => println("not in the table")
// ```
pub fn schema_for(domain: Str, op_type: Str, version: Int) -> ?OnnxOpSchema []
    let prefix = domain + "|" + op_type + "|"
    var best = ""
    var best_since = -1
    for line in ROWS
        if str.starts_with(line, prefix)
            let since = since_of(line)
            if since <= version and since > best_since
                best_since = since
                best = line
    if best_since < 0
        return None
    Some(schema_of_line(best))

// Every version of an operator the table carries, oldest first.
//
// What a converter walks to find the step between two opsets.
//
// ```novo
// use std.list
// use onnxopset
//
// fn main() [io]
//     println("${list.len(onnxopset.versions_of("", "Squeeze")) >= 2}")   // true
// ```
pub fn versions_of(domain: Str, op_type: Str) -> [OnnxOpSchema] []
    let prefix = domain + "|" + op_type + "|"
    var out: [OnnxOpSchema] = []
    for line in ROWS
        if str.starts_with(line, prefix)
            out = insert_by_since(out, schema_of_line(line))
    out

// The version at which an operator first appeared, or `None`.
//
// ```novo
// use onnxopset
//
// fn main() [io]
//     match onnxopset.introduced_at("", "Conv")
//         Some(v) => println("${v}")            // 1
//         None    => println("not in the table")
// ```
pub fn introduced_at(domain: Str, op_type: Str) -> ?Int []
    let prefix = domain + "|" + op_type + "|"
    var best = -1
    for line in ROWS
        if str.starts_with(line, prefix)
            let since = since_of(line)
            if best < 0 or since < best
                best = since
    if best < 0
        return None
    Some(best)

// Whether the table knows an operator in a domain at all.
//
// ```novo
// use onnxopset
//
// fn main() [io]
//     println("${onnxopset.is_known("", "Conv")}")            // true
//     println("${onnxopset.is_known("", "NotAnOperator")}")   // false
// ```
pub fn is_known(domain: Str, op_type: Str) -> Bool []
    match introduced_at(domain, op_type)
        Some(_) => true
        None    => false

// Whether a supplied-input count fits a schema's arity.
//
// Variadic when `max_input` is `-1`, in which case only the minimum
// is checked.
//
// ```novo
// use onnxopset
//
// fn main() [io]
//     match onnxopset.schema_for("", "Conv", 17)
//         Some(s) => println("${onnxopset.accepts_inputs(s, 3)}")   // true
//         None    => println("not in the table")
// ```
pub fn accepts_inputs(s: OnnxOpSchema, count: Int) -> Bool []
    if count < s.min_input
        return false
    if s.max_input < 0
        return true
    count <= s.max_input

// Whether an output count fits a schema's arity.
//
// ```novo
// use onnxopset
//
// fn main() [io]
//     match onnxopset.schema_for("", "Conv", 17)
//         Some(s) => println("${onnxopset.accepts_outputs(s, 1)}")   // true
//         None    => println("not in the table")
// ```
pub fn accepts_outputs(s: OnnxOpSchema, count: Int) -> Bool []
    if count < s.min_output
        return false
    if s.max_output < 0
        return true
    count <= s.max_output

// Whether the operator's last input is variadic.
//
// ```novo
// use onnxopset
//
// fn main() [io]
//     match onnxopset.schema_for("", "Concat", 17)
//         Some(s) => println("${onnxopset.is_variadic_input(s)}")   // true
//         None    => println("not in the table")
// ```
pub fn is_variadic_input(s: OnnxOpSchema) -> Bool []
    s.max_input < 0

// Whether an attribute name is one the operator accepts.
//
// ```novo
// use onnxopset
//
// fn main() [io]
//     match onnxopset.schema_for("", "Conv", 17)
//         Some(s) => println("${onnxopset.accepts_attribute(s, "kernel_shape")}")
//         None    => println("not in the table")
// ```
pub fn accepts_attribute(s: OnnxOpSchema, name: Str) -> Bool []
    list.contains(s.attributes, name)

// Whether an attribute name is one the operator requires.
//
// ```novo
// use onnxopset
//
// fn main() [io]
//     match onnxopset.schema_for("", "Conv", 17)
//         Some(s) => println("${onnxopset.requires_attribute(s, "kernel_shape")}")
//         None    => println("not in the table")
// ```
pub fn requires_attribute(s: OnnxOpSchema, name: Str) -> Bool []
    list.contains(s.required_attributes, name)

// Every operator the table carries for a domain, in name order.
//
// ```novo
// use std.list
// use onnxopset
//
// fn main() [io]
//     println("${list.len(onnxopset.operators_in("")) > 100}")   // true
// ```
pub fn operators_in(domain: Str) -> [Str] []
    let prefix = domain + "|"
    var out: [Str] = []
    for line in ROWS
        if str.starts_with(line, prefix)
            let op_type = list.get(fields_of(line), 1)
            if not list.contains(out, op_type)
                list.push(out, op_type)
    out

// Every domain the table carries.
//
// ```novo
// use std.list
// use onnxopset
//
// fn main() [io]
//     println("${list.len(onnxopset.domains()) >= 2}")   // true
// ```
pub fn domains() -> [Str] []
    var out: [Str] = []
    for line in ROWS
        let domain = domain_of(line)
        if not list.contains(out, domain)
            list.push(out, domain)
    out

// The version at which an operator's spelling last changed at or
// before a version, or `None`.
//
// What a converter asks to find out whether a node has to be rewritten
// between two opsets: if this is the same for both, the node is
// unchanged.
//
// ```novo
// use onnxopset
//
// fn main() [io]
//     match onnxopset.last_change_before("", "Squeeze", 17)
//         Some(v) => println("${v}")            // 13
//         None    => println("not in the table")
// ```
pub fn last_change_before(domain: Str, op_type: Str, version: Int) -> ?Int []
    match schema_for(domain, op_type, version)
        Some(s) => Some(s.since_version)
        None    => None
// THE TABLE
//
// One row per (domain, operator, `since_version`), emitted from the
// ONNX documentation's per-version changelogs: the default domain up to
// opset 21 and `ai.onnx.ml` up to opset 5, which are the two operator
// sets the changelog describes version history for and the two a model
// reaches for without a vendor's runtime.
//
// Ten `|`-separated fields:
//
//     domain | op type | since | min in | max in | min out | max out |
//     deprecated | required attributes | accepted attributes
//
// `max` is `-1` when the last input — or output — is variadic:
// `Concat` takes any number above its minimum, `Split` gives any
// number.  The two name fields are comma-separated, and the accepted
// list is the attributes the specification documents, which is what a
// node may carry.  An empty field is `""`, never a zero standing in for
// something the row does not mean.
//
// Rows are ordered by (domain, operator, since), which makes a scan of
// the table a walk in version order for one operator and in name order
// for one domain.  `insert_by_since` does not rely on that, but
// `operators_in` does.
//
// A row is a snapshot of the specification at one version, and this
// package does not update itself: a model importing an opset above the
// table's ceiling still reads, and `onnxcheck` is what says the table
// cannot speak for it.
const ROWS: [Str] = [
    "|Abs|1|1|1|1|1|||consumed_inputs",
    "|Abs|6|1|1|1|1|||",
    "|Abs|13|1|1|1|1|||",
    "|Acos|7|1|1|1|1|||",
    "|Acosh|9|1|1|1|1|||",
    "|Add|1|2|2|1|1|||axis,broadcast,consumed_inputs",
    "|Add|6|2|2|1|1|||axis,broadcast",
    "|Add|7|2|2|1|1|||",
    "|Add|13|2|2|1|1|||",
    "|Add|14|2|2|1|1|||",
    "|AffineGrid|20|2|2|1|1|||align_corners",
    "|And|1|2|2|1|1|||axis,broadcast",
    "|And|7|2|2|1|1|||",
    "|ArgMax|1|1|1|1|1|||axis,keepdims",
    "|ArgMax|11|1|1|1|1|||axis,keepdims",
    "|ArgMax|12|1|1|1|1|||axis,keepdims,select_last_index",
    "|ArgMax|13|1|1|1|1|||axis,keepdims,select_last_index",
    "|ArgMin|1|1|1|1|1|||axis,keepdims",
    "|ArgMin|11|1|1|1|1|||axis,keepdims",
    "|ArgMin|12|1|1|1|1|||axis,keepdims,select_last_index",
    "|ArgMin|13|1|1|1|1|||axis,keepdims,select_last_index",
    "|Asin|7|1|1|1|1|||",
    "|Asinh|9|1|1|1|1|||",
    "|Atan|7|1|1|1|1|||",
    "|Atanh|9|1|1|1|1|||",
    "|AveragePool|1|1|1|1|1||kernel_shape|auto_pad,kernel_shape,pads,strides",
    "|AveragePool|7|1|1|1|1||kernel_shape|auto_pad,count_include_pad,kernel_shape,pads,strides",
    "|AveragePool|10|1|1|1|1||kernel_shape|auto_pad,ceil_mode,count_include_pad,kernel_shape,pads,strides",
    "|AveragePool|11|1|1|1|1||kernel_shape|auto_pad,ceil_mode,count_include_pad,kernel_shape,pads,strides",
    "|AveragePool|19|1|1|1|1||kernel_shape|auto_pad,ceil_mode,count_include_pad,dilations,kernel_shape,pads,strides",
    "|BatchNormalization|1|5|5|1|5||consumed_inputs|consumed_inputs,epsilon,is_test,momentum,spatial",
    "|BatchNormalization|6|5|5|1|5|||epsilon,is_test,momentum,spatial",
    "|BatchNormalization|7|5|5|1|5|||epsilon,momentum,spatial",
    "|BatchNormalization|9|5|5|1|5|||epsilon,momentum",
    "|BatchNormalization|14|5|5|1|3|||epsilon,momentum,training_mode",
    "|BatchNormalization|15|5|5|1|3|||epsilon,momentum,training_mode",
    "|Bernoulli|15|1|1|1|1|||dtype,seed",
    "|BitShift|11|2|2|1|1||direction|direction",
    "|BitwiseAnd|18|2|2|1|1|||",
    "|BitwiseNot|18|1|1|1|1|||",
    "|BitwiseOr|18|2|2|1|1|||",
    "|BitwiseXor|18|2|2|1|1|||",
    "|BlackmanWindow|17|1|1|1|1|||output_datatype,periodic",
    "|Cast|1|1|1|1|1||to|to",
    "|Cast|6|1|1|1|1||to|to",
    "|Cast|9|1|1|1|1||to|to",
    "|Cast|13|1|1|1|1||to|to",
    "|Cast|19|1|1|1|1||to|saturate,to",
    "|Cast|21|1|1|1|1||to|saturate,to",
    "|CastLike|15|2|2|1|1|||",

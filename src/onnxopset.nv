    "|Exp|6|1|1|1|1|||",
    "|Exp|13|1|1|1|1|||",
    "|Expand|8|2|2|1|1|||",
    "|Expand|13|2|2|1|1|||",
    "|EyeLike|9|1|1|1|1|||dtype,k",
    "|Flatten|1|1|1|1|1|||axis",
    "|Flatten|9|1|1|1|1|||axis",
    "|Flatten|11|1|1|1|1|||axis",
